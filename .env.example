# Copy to .env (git-ignored) and fill in. `docker compose up` works with the defaults below:
# replay mode needs no credentials at all.

# --- Mode -------------------------------------------------------------------
# replay = play the recorded fixtures in fixtures/realtime on a loop (default, no keys)
# live   = poll the real MTA GTFS-realtime endpoints
TRACKNYC_MODE=replay

# --- Credentials (all optional) ---------------------------------------------
# The MTA's GTFS-realtime feeds are currently served without a key. If your MTA developer
# account still issues one, put it here and it is sent as the `x-api-key` header.
MTA_API_KEY=

# --- Database / cache (defaults match docker compose) ------------------------
DATABASE_URL=jdbc:postgresql://postgres:5432/tracknyc
DATABASE_USER=tracknyc
DATABASE_PASSWORD=change-me-in-production
REDIS_URL=redis://redis:6379

# --- Web --------------------------------------------------------------------
# Base map style (free, no key). Override to self-host Protomaps tiles.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
