# syntax=docker/dockerfile:1
# Build the Spring Boot service. Layered so dependency downloads are cached between builds.
FROM eclipse-temurin:22-jdk-jammy AS build
WORKDIR /src
COPY gradlew settings.gradle.kts build.gradle.kts gradle.properties ./
COPY gradle gradle
COPY live-core live-core
COPY tracknyc-service tracknyc-service
RUN --mount=type=cache,target=/root/.gradle ./gradlew --no-daemon :tracknyc-service:bootJar -x test

FROM eclipse-temurin:22-jre-jammy AS runtime
RUN useradd --system --uid 10001 tracknyc
WORKDIR /app
COPY --from=build /src/tracknyc-service/build/libs/tracknyc-service.jar app.jar
# The replay fixtures ship in the image so `docker compose up` needs no extra downloads.
COPY fixtures /app/fixtures
USER 10001
EXPOSE 8080
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+UseZGC" \
    TRACKNYC_FIXTURES_DIR=/app/fixtures
HEALTHCHECK --interval=15s --timeout=3s --start-period=40s \
  CMD ["sh", "-c", "wget -qO- http://localhost:8080/actuator/health/readiness | grep -q UP"]
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
